{
  "manifest_version": 3,
  "name": "LINUX DO Credit Payment",
  "version": "1.1.1",
  "description": "轻量级 LINUX DO Credit 流转插件",
  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "webNavigation",
    "webRequest",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.linux.do/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://linux.do/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LINUX DO Credit",
    "default_icon": {
      "16": "icon/icon16.png",
      "32": "icon/icon32.png",
      "48": "icon/icon48.png",
      "128": "icon/icon128.png"
    }
  },
  "icons": {
    "16": "icon/icon16.png",
    "32": "icon/icon32.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  }
}